// Description:
//   This file defines the Control and Status Registers (CSR) of the
//   openCologne-PCIE EndPoint SOC -- the TLP transmit/receive window that
//   the eduBOS5 firmware uses to answer the Memory requests of the host.
//   Configuration requests are answered by the TL itself, they never get
//   here.
//
//   Register map:
//
//     0x3000_0000  -               free (was tx.header0..2)
//     0x3000_000C  tx.send         send the TLP in tx_payload (W, triggers)
//     0x3000_0010  -               free (was rx.header0..2, rx.data)
//     0x3000_0020  rx.valid        a TLP is waiting          (R, W1C)
//     0x3000_0024  -               free (was status.err)
//     0x3000_0028  status.phy      Tx FSM busy               (R)
//     0x3000_002C  status.result   firmware result marker    (W)
//     0x3000_0030  status.cfg_id   own Bus/Device/Function   (R)
//==========================================================================

addrmap csr {
   name = "csr";
   desc = "openCologne-PCIE EndPoint CSR";

   littleendian;
   default accesswidth = 32;
   default regwidth = 32;
   default alignment = 4;
   addressing = compact;

   //-----------------------------------------------------------------------
   // Tx -- the TLP the CPU hands over to the PCIe link
   //-----------------------------------------------------------------------
   regfile tx {
      name = "csr.tx";
      desc = "TLP Transmit CSR (CPU --> PCIe link). The TLP goes in
              tx_payload, header first; writing tx.send launches it.";

      external reg {
         name = "csr.tx.send";
         desc = "TLP Send -- writing this register STARTS the transfer";

         field {
            name = "csr.tx.send.go";
            desc = "Any write launches the Tx FSM on the TLP in tx_payload, so
                    it comes LAST, after every entry of the TLP. The FSM takes
                    the length from DW0 (Fmt and Length). External: nothing is
                    stored, the write strobe (req) starts the FSM.";
            sw = w;
            hw = r;
         } go[0:0] = 0;
      } send @ 0x0C;  // 0x00 to 0x08: free, they held the header
   } tx @ 0x00;

   //-----------------------------------------------------------------------
   // Rx -- the TLP coming in from the link, captured as-is
   //-----------------------------------------------------------------------
   regfile rx {
      name = "csr.rx";
      desc = "TLP Receive CSR (PCIe link --> CPU). An incoming TLP is captured
              as it is, every DWORD in rx_payload (entry i is DW i). The
              firmware decodes it, then clears rx.valid to take the next TLP.";

      reg {
         name = "csr.rx.valid";
         desc = "Receive Status Register";

         field {
            name = "csr.rx.valid.valid";
            desc = "Set by hardware when a TLP has been captured. While it is
                    set, the link is held off (m_axis_rx.tready low). Software
                    writes 1 to clear it once it has read the TLP.";
            sw = rw;
            onwrite = woclr;
            hw = r;
            hwset;
         } valid[0:0] = 0;
      } valid @ 0x10;  // 0x10 to 0x1C: free, they held the header
   } rx @ 0x10;

   //-----------------------------------------------------------------------
   // Status -- what the PCIe core and the Tx FSM report
   //-----------------------------------------------------------------------
   regfile status {
      name = "csr.status";
      desc = "PCIe Link Status CSR";

      reg {
         name = "csr.status.phy";
         desc = "Tx FSM Status Register";

         field {
            name = "csr.status.phy.tx_busy";
            desc = "The Tx FSM is sending a TLP. Software polls for 0 before
                    it writes the next TLP into tx_payload.";
            sw = r;
            hw = w;
         } tx_busy[0:0] = 0;
      } phy @ 0x04;  // 0x00 (0x3000_0024): free, it held status.err

      external reg {
         name = "csr.status.result";
         desc = "Firmware Result Register";

         field {
            name = "csr.status.result.marker[31:0]";
            desc = "Result marker the firmware writes when it stops, e.g.
                    0x0000FACE for PASS. Unlike tx.send, writing it launches
                    no TLP. The SOC keeps only one bit, whether the marker
                    is PASS, for the PASS LED.";
            sw = w;
            hw = r;
         } marker[32] = 0;
      } result;

      reg {
         name = "csr.status.cfg_id";
         desc = "Core ID: the EP's own Bus/Device/Function number";

         field {
            name = "csr.status.cfg_id.id[15:0]";
            desc = "Bus[15:8], Device[7:3] and Function[2:0] of this EP, as
                    the TL captured them from the last Type 0 Configuration
                    Write (UG477 cfg_bus_number, cfg_device_number,
                    cfg_function_number). The firmware puts this value in the
                    Completer ID of every Completion it sends. It is 0 until
                    the host has configured the EP, and its bus number depends
                    on the topology: behind a switch it is not the same as on
                    a direct link.";
            sw = r;
            hw = w;
         } id[15:0] = 0;
      } cfg_id;
   } status @ 0x24;

   //-----------------------------------------------------------------------
   // Payload windows -- every DWORD of a TLP, header first, as many as a
   // MemWr of Max_Payload_Size (128 bytes) and a 4-DW header take
   //-----------------------------------------------------------------------
   external mem {
      name = "csr.rx_payload";
      desc = "DWORDs of the received TLP, header first, captured with
              rx.valid: entry i is DW i. DWORDs past the last entry are
              dropped.";
      mementries = 64;
      memwidth = 32;
      sw = r;
   } rx_payload @ 0x100;

   external mem {
      name = "csr.tx_payload";
      desc = "DWORDs of the outgoing TLP, header first: entry i is DW i.
              Writing tx.send then launches it. The TLP's Fmt and Length say
              how many entries go out.";
      mementries = 64;
      memwidth = 32;
      sw = w;
   } tx_payload @ 0x200;
};

//==========================================================================
// SOC top level -- the address map the eduBOS5 firmware sees
//==========================================================================
addrmap opencologne_pcie {
   littleendian;
   default accesswidth = 32;
   default regwidth = 32;
   default alignment = 4;
   addressing = compact;

   // 8 KB of unified instruction/data RAM, initialised from firmware.hex
   external mem imem {
      name = "imem";
      desc = "CPU Program/Data Memory";
      mementries = 2048;
      memwidth = 32;
   } imem @ 0x0000_0000;

   csr csr @ 0x3000_0000;
};

